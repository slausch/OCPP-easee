{
    "elements": [
        {
            "caption": "Charge Point Identity",
            "name": "ChargePointIdentity",
            "type": "ValidationTextBox"
        },
        {
            "type": "Select",
            "name": "ValidateIdTag",
            "width": "608px",
            "caption": "Start transaction...",
            "options": [
                {
                    "caption": "... automatically on connection",
                    "value": -1
                },
                {
                    "caption": "... when an Id Tag is validated - Allow all Id Tags",
                    "value": 0
                },
                {
                    "caption": "... when an Id Tag is validated - Allow only Central Id Tag list",
                    "value": 1
                },
                {
                    "caption": "... when an Id Tag is validated - Allow only Local Id Tag list",
                    "value": 2
                },
                {
                    "caption": "... when an Id Tag is validated - Allow both Id Tag lists",
                    "value": 3
                }
            ],
            "onChange": "OCPPEASEE_UIUpdateCP($id, $ValidateIdTag);"
        },
        {
            "type": "List",
            "name": "ValidIdTagList",
            "caption": "Local list of valid Id Tags (e.g. RFID cards)",
            "add": true,
            "delete": true,
            "sort": {
                "column": "IdTag",
                "direction": "ascending"
            },
            "columns": [
                {
                    "caption": "Id Tag",
                    "name": "IdTag",
                    "width": "150px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "First Name",
                    "name": "FirstName",
                    "width": "150px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Last Name",
                    "name": "LastName",
                    "width": "150px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "E-Mail",
                    "name": "EMail",
                    "width": "150px",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                },
                {
                    "caption": "Information",
                    "name": "Information",
                    "width": "auto",
                    "add": "",
                    "edit": {
                        "type": "ValidationTextBox"
                    }
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Smart Charging",
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "DefaultConnectorId",
                    "caption": "Default connector ID",
                    "minimum": 1,
                    "maximum": 2
                },
                {
                    "type": "NumberSpinner",
                    "name": "MaximumChargingCurrent",
                    "caption": "Maximum charging current",
                    "minimum": 1,
                    "maximum": 80,
                    "suffix": " A"
                },
                {
                    "type": "NumberSpinner",
                    "name": "ChargingProfileId",
                    "caption": "Charging profile ID",
                    "minimum": 1
                },
                {
                    "type": "NumberSpinner",
                    "name": "ChargingProfileStackLevel",
                    "caption": "Charging profile stack level",
                    "minimum": 0,
                    "maximum": 9
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "Update",
            "onClick": "OCPPEASEE_Update($id);"
        },
        {
            "type": "Button",
            "caption": "Refresh OCPP configuration",
            "onClick": "OCPPEASEE_RefreshConfiguration($id);"
        },
        {
            "type": "Button",
            "caption": "Get composite schedule",
            "onClick": "OCPPEASEE_GetCompositeSchedule($id, 0, 86400);"
        },
        {
            "type": "Button",
            "caption": "Clear charging profile",
            "confirm": "Really clear the configured charging profile?",
            "onClick": "OCPPEASEE_ClearChargingProfile($id, 0);"
        }
    ],
    "status": []
}
